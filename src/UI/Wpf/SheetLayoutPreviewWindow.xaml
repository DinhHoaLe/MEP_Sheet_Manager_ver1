<Window x:Class="MEP_Sheet_Manager.SheetLayoutPreviewWindow"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 Title="Preview bố trí sheet" Width="1180" Height="780" MinWidth="950" MinHeight="620"
 WindowStartupLocation="CenterOwner" Background="#F5F2EE" FontFamily="Segoe UI" FontSize="13" Foreground="#37322B">
 <Window.Resources>
  <Style TargetType="Button"><Setter Property="Padding" Value="16,9"/><Setter Property="Margin" Value="6,0,0,0"/><Setter Property="Background" Value="White"/><Setter Property="BorderBrush" Value="#DDD6CE"/></Style>
  <Style TargetType="TextBox"><Setter Property="Padding" Value="8,7"/><Setter Property="BorderBrush" Value="#DDD6CE"/></Style>
 </Window.Resources>
 <Grid Margin="24">
  <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
  <StackPanel><TextBlock Text="Preview bố trí sheet" FontSize="25" FontWeight="SemiBold"/>
   <TextBlock Text="Kéo ảnh/khung viewport để đổi vị trí. Chừa trái 44 mm và phải 94 mm (85 + 9) cho khung tên/khung ngoài." Margin="0,7,0,14" Foreground="#716B63"/>
  </StackPanel>
  <Grid Grid.Row="1" Margin="0,0,0,14"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
   <ComboBox x:Name="Sheets" DisplayMemberPath="Label" MinHeight="36" Margin="0,0,16,0" SelectionChanged="Sheet_Changed"/>
   <StackPanel Grid.Column="1" Orientation="Horizontal">
    <TextBlock Text="X (mm)" VerticalAlignment="Center" Margin="0,0,6,0"/><TextBox x:Name="XInput" Width="96"/>
    <TextBlock Text="Y (mm)" VerticalAlignment="Center" Margin="14,0,6,0"/><TextBox x:Name="YInput" Width="96"/>
    <Button Content="Cập nhật X/Y" Click="Coordinates_Click"/>
    <Button Content="Canh giữa" Click="Center_Click"/>
   </StackPanel>
  </Grid>
  <Border Grid.Row="2" Background="#E8E2DA" BorderBrush="#DDD6CE" BorderThickness="1" CornerRadius="10" ClipToBounds="True">
   <Canvas x:Name="PreviewCanvas" Background="Transparent" SizeChanged="Canvas_SizeChanged"
    MouseLeftButtonDown="Canvas_MouseDown" MouseMove="Canvas_MouseMove" MouseLeftButtonUp="Canvas_MouseUp" LostMouseCapture="Canvas_LostCapture"/>
  </Border>
  <TextBlock x:Name="PreviewStatus" Grid.Row="3" Margin="0,12,0,10" TextWrapping="Wrap" Foreground="#716B63"/>
  <DockPanel Grid.Row="4">
   <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
    <Button Content="Đóng" Click="Close_Click"/>
    <Button x:Name="SaveFileButton" Content="Lưu file bố trí…" Click="SaveFile_Click"/>
    <Button x:Name="UseLayoutButton" Content="Dùng vị trí và đóng" Background="#62543C" Foreground="White" Click="Use_Click"/>
   </StackPanel>
   <TextBlock Text="Lưu/Dùng vị trí chỉ cập nhật bố trí. Bấm Áp dụng tại View List để ghi vào Revit." TextWrapping="Wrap" VerticalAlignment="Center" Margin="0,0,14,0"/>
  </DockPanel>
 </Grid>
</Window>

