    <Compile Include="src\UI\Wpf\SheetManagerWindow.xaml.cs"><DependentUpon>SheetManagerWindow.xaml</DependentUpon></Compile>
    <Page Include="src\UI\Wpf\SheetManagerWindow.xaml"><Generator>MSBuild:Compile</Generator><SubType>Designer</SubType></Page>
  </ItemGroup>
  <Import Project="$(MSBuildToolsPath)\Microsoft.CSharp.targets" />
