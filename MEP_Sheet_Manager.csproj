    <Compile Include="src\UI\Wpf\SheetLayoutPreviewWindow.xaml.cs"><DependentUpon>SheetLayoutPreviewWindow.xaml</DependentUpon></Compile>
    <Page Include="src\UI\Wpf\SheetLayoutPreviewWindow.xaml"><Generator>MSBuild:Compile</Generator><SubType>Designer</SubType></Page>
    <Compile Include="src\Services\Revit\FloorPlanPlacementService.cs" />
    <Compile Include="src\Services\Revit\ScopeBoxAlignmentService.cs" />
    <Compile Include="src\Services\Revit\TitleBlockPreviewService.cs" />
