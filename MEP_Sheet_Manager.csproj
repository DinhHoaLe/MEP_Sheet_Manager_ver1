    <Reference Include="WindowsBase" />
    <Reference Include="PresentationCore" />
    <Reference Include="PresentationFramework" />
    <Reference Include="System.Xaml" />
    <Reference Include="System.Drawing" />
    <Reference Include="System.Windows.Forms" />
    <Reference Include="RevitAPI"><HintPath>$(RevitInstallDir)\RevitAPI.dll</HintPath><Private>False</Private></Reference>
    <Reference Include="RevitAPIUI"><HintPath>$(RevitInstallDir)\RevitAPIUI.dll</HintPath><Private>False</Private></Reference>
    <Compile Include="src\Commands\GetAllSheetNamesCommand.cs" />
    <Compile Include="src\Models\SheetInfo.cs" /><Compile Include="src\Models\SheetBrowserInfo.cs" /><Compile Include="src\Services\Revit\SheetBrowserService.cs" />
