    <Compile Include="src\UI\Wpf\ToolDialog.cs" />
    <Compile Include="src\UI\Wpf\SheetManagerTools.cs" />
    <Compile Include="src\Models\ProjectListInfo.cs" />
    <Compile Include="src\Models\SheetViewAssignment.cs" />
    <Compile Include="src\Models\SheetLayoutInfo.cs" />
    <Compile Include="src\Models\SheetLayoutMargins.cs" />
